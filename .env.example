# ==============================================
# متغيرات البيئة المطلوبة على Vercel (Project Settings → Environment Variables)
# ==============================================

# رابط قاعدة بيانات MongoDB Atlas
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/lotus_dental_care

# سر توقيع الـ JWT - غيّره لنص عشوائي طويل وسري
JWT_SECRET=change_this_to_a_long_random_secret_key
JWT_EXPIRES_IN=7d

# رابط الفرونت إند بعد النشر (لإعدادات CORS) - مثال: https://lotus-dental.vercel.app
CLIENT_URL=http://localhost:5173

# ==============================================
# متغير بيئة خاص بالفرونت إند فقط (client/.env)
# ==============================================
# على Vercel، بما إن الـ API والفرونت إند بيتنشروا مع بعض على نفس الدومين،
# سيبه فاضي أو حطه "/api" وهيشتغل تلقائي بدون الحاجة لدومين منفصل
VITE_API_URL=/api
